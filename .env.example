APP_NAME="ML Prediction Service"
APP_ENV=local
APP_DEBUG=true
API_V1_PREFIX=/api/v1
POSTGRES_USER=ml_user
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ml_prediction_service
DATABASE_URL=postgresql+psycopg://ml_user:change-me@postgres:5432/ml_prediction_service
REDIS_URL=redis://redis:6379/0
JWT_SECRET_KEY=change-me-to-a-long-random-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
MODEL_STORAGE_PATH=/var/lib/ml_prediction_service/models
MAX_MODEL_UPLOAD_SIZE_BYTES=10485760
PREDICTION_PRICE_CREDITS=1
BACKEND_PORT=18000
DASHBOARD_PORT=18501
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
POSTGRES_PORT=15432
REDIS_PORT=16379
